# Vercel environment variables (Project → Settings → Environment Variables). Never commit real values.

# "supabase" = use Supabase (requires the two keys below), "local" = force Browser demo mode.
# Leave empty to auto-detect: Supabase when configured, otherwise Browser demo mode.
SHOPDESK_STORAGE_MODE=

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-only. Never prefix with NEXT_PUBLIC_ or put in frontend code.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=shopdesk-photos

# Random string, 32+ characters, used to sign the HttpOnly browser-identity cookie.
# Generate one with:  openssl rand -base64 48
SHOPDESK_AUTH_SECRET=
